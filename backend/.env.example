# MongoDB Atlas connection string
MONGO_URI=your url



# Server port
PORT=5001

# Razorpay Keys (get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Admin login (for /admin dashboard)
ADMIN_EMAIL=admin@yourcrackersshop.com
ADMIN_PASSWORD=changeme123
# Random long string, used to sign admin login tokens - change this to your own random value
JWT_SECRET=replace_this_with_a_long_random_string_before_deploying


CLIENT_URL=http://localhost:3000
# Email for order notifications (optional, uses Gmail app password)
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your16digitapppassword
